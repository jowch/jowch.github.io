---
import Base from '../layouts/Base.astro'
import Pub from '../components/Pub.astro'
import { loadPubs } from '../lib/pubs'
const pubs = await loadPubs()
---

<Base title="Publications">
  <section class="mx-auto max-w-3xl px-4 sm:px-6 pt-14">
    <p class="eyebrow">Publications</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl font-medium">Papers</h1>
    <p class="mt-4 text-ink-2">
      Also on <a class="link" href="https://orcid.org/0000-0001-5283-243X">ORCID</a>.
    </p>
    <div class="mt-10 border-t border-rule">
      {pubs.map(pub => <Pub pub={pub} />)}
    </div>
  </section>
</Base>
