---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  return projects.map(p => ({ params: { slug: p.id }, props: { project: p, all: projects } }))
}

const { project, all } = Astro.props
const { data } = project
const { Content } = await render(project)
const related = all.filter(p => data.related.includes(p.id))
---

<Base title={data.name} description={`${data.name}: ${data.tagline}`}>
  <div style={`--project: ${data.accent}`}>
    <section class="relative overflow-hidden border-b border-rule">
      <div aria-hidden="true" class="absolute inset-0 opacity-[0.08] bg-[radial-gradient(60%_80%_at_85%_10%,var(--project),transparent)]"></div>
      <div class="relative mx-auto max-w-5xl px-4 sm:px-6 pt-12 pb-12">
        <a href="/projects/" class="text-sm text-ink-3 hover:text-ink">← All projects</a>
        <div class="mt-8 grid gap-10 md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <div class="flex items-center gap-4">
              {data.logoDark ? (
                <>
                  <img src={data.logo} alt="" width="64" height="64" class="size-16 object-contain dark:hidden" />
                  <img src={data.logoDark} alt="" width="64" height="64" class="size-16 object-contain hidden dark:block" />
                </>
              ) : (
                <img src={data.logo} alt="" width="64" height="64" class="size-16 object-contain" />
              )}
              <div>
                <h1 class="display text-4xl sm:text-5xl font-semibold leading-none">{data.name}</h1>
                <p class="mt-2 text-[0.72rem] font-semibold uppercase tracking-wider text-ink-3">{data.language} · {data.status}</p>
              </div>
            </div>
            <p class="display mt-6 text-2xl sm:text-3xl leading-snug max-w-2xl">{data.tagline}</p>
            <div class="mt-7 flex flex-wrap gap-3">
              {data.docs && (
                <a href={data.docs} class="inline-flex items-center gap-2 rounded-full bg-[var(--project)] text-white px-4 py-2 text-sm font-medium hover:brightness-110 transition">Documentation →</a>
              )}
              <a href={data.repo} class="inline-flex items-center gap-2 rounded-full border border-ink/70 px-4 py-2 text-sm font-medium hover:bg-ink hover:text-paper transition-colors">GitHub</a>
            </div>
          </div>
          <div class="w-full md:w-[22rem] rounded-xl border border-rule bg-paper shadow-[0_10px_30px_-18px_var(--project)] overflow-hidden">
            <div class="flex items-center justify-between px-4 py-2 border-b border-rule bg-paper-2">
              <span class="text-[0.72rem] font-semibold uppercase tracking-wider text-ink-3">{data.install.label}</span>
              <span class="size-2 rounded-full bg-[var(--project)]" aria-hidden="true"></span>
            </div>
            <pre class="px-4 py-3 font-mono text-[0.8rem] leading-relaxed overflow-x-auto"><code>{data.install.code.trim()}</code></pre>
          </div>
        </div>
      </div>
    </section>

    {data.hero && (
      <section class="mx-auto max-w-5xl px-4 sm:px-6 pt-12">
        <img src={data.hero.src} alt={data.hero.alt} class="mx-auto w-full max-w-3xl rounded-xl border border-rule" loading="lazy" />
      </section>
    )}

    <article class="mx-auto max-w-5xl px-4 sm:px-6 pt-4">
      <div class="prose-site max-w-prose mx-auto [&>h2:first-child]:mt-10">
        <Content />
      </div>
    </article>

    {related.length > 0 && (
      <aside class="mx-auto max-w-prose px-4 sm:px-0 mt-16">
        <p class="eyebrow mb-3">Related</p>
        {related.map(r => (
          <a href={`/projects/${r.id}/`} class="flex items-center gap-4 rounded-xl border border-rule p-4 hover:border-[var(--r)] transition-colors" style={`--r: ${r.data.accent}`}>
            <img src={r.data.logo} alt="" width="36" height="36" class="size-9 object-contain" />
            <div>
              <p class="font-semibold">{r.data.name}</p>
              <p class="text-sm text-ink-2">{r.data.tagline}</p>
            </div>
          </a>
        ))}
      </aside>
    )}
  </div>
</Base>
