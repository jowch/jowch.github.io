---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Stack from '../../components/Stack.astro'
import ProjectCard from '../../components/ProjectCard.astro'
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order)
---

<Base title="Projects" description="Open-source tools for reproducible, interactive science: Masque.jl, Ember, EndeavorMCP and Endeavor.">
  <section class="mx-auto max-w-5xl px-4 sm:px-6 pt-14">
    <p class="eyebrow">Projects</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl font-medium max-w-3xl">Tools for doing science in code, without being a software engineer.</h1>
    <p class="mt-5 max-w-2xl text-lg text-ink-2">
      Each one keeps the work in plain, rerunnable code while removing a reason
      not to use it: setup, hidden state, static figures, or not knowing where to start.
    </p>
    <div class="mt-12 rounded-2xl border border-rule bg-paper-2/60 p-6 sm:p-8">
      <Stack />
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {projects.map(p => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>
