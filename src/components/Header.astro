---
const path = Astro.url.pathname
const nav = [
  { href: '/#research', label: 'Research', wide: true },
  { href: '/projects/', label: 'Projects' },
  { href: '/publications/', label: 'Publications' },
]
const active = (href: string) => path.startsWith(href)
---

<header class="border-b border-rule/80 bg-paper/85 backdrop-blur supports-[backdrop-filter]:bg-paper/70 sticky top-0 z-20">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 h-14 flex items-center justify-between gap-4">
    <a href="/" class="display whitespace-nowrap text-lg sm:text-xl font-semibold tracking-tight hover:text-accent transition-colors">
      Jonathan Chen
    </a>
    <nav class="flex items-center gap-0 sm:gap-1 text-[0.9rem] sm:text-[0.95rem] font-medium">
      {nav.map(({ href, label, wide }) => (
        <a
          href={href}
          class:list={[
            'px-1.5 sm:px-2 py-1 rounded transition-colors',
            wide && 'hidden sm:inline-block',
            active(href) ? 'text-accent bg-accent-soft' : 'text-ink-2 hover:text-ink',
          ]}
          aria-current={active(href) ? 'page' : undefined}
        >{label}</a>
      ))}
      <button
        id="theme-toggle"
        type="button"
        class="ml-1 p-1.5 rounded text-ink-2 hover:text-ink"
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" class="dark:hidden" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle').addEventListener('click', () => {
    const root = document.documentElement
    const dark = root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches
    root.dataset.theme = dark ? 'light' : 'dark'
    try { localStorage.setItem('theme', root.dataset.theme) } catch {}
  })
</script>
