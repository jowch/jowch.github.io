---
// Placeholder illustrations for research areas, drawn in the site palette.
interface Props { kind: 'membrane' | 'surface' }
const { kind } = Astro.props
const heads = Array.from({ length: 9 }, (_, i) => 14 + i * 12.5)
---

<svg viewBox="0 0 120 120" class="size-full" aria-hidden="true">
  <rect width="120" height="120" rx="10" fill="var(--paper-2)" />
  {kind === 'membrane' ? (
    <g>
      {heads.map(x => <circle cx={x} cy="58" r="4.6" fill="var(--ink-3)" opacity="0.55" />)}
      {heads.map(x => <circle cx={x} cy="86" r="4.6" fill="var(--ink-3)" opacity="0.55" />)}
      {heads.map(x => <path d={`M${x - 1.6} 63v8M${x + 1.6} 63v8M${x - 1.6} 73v8M${x + 1.6} 73v8`} stroke="var(--ink-3)" stroke-width="1" opacity="0.4" />)}
      {[[52, 20], [58, 28], [64, 34], [58, 42], [62, 50], [56, 58], [60, 66]].map(([x, y], i) => (
        <circle cx={x} cy={y} r="4.2" fill="var(--accent)" opacity={i < 3 ? 0.55 : 0.95} />
      ))}
    </g>
  ) : (
    <g>
      <rect x="10" y="92" width="100" height="4" rx="2" fill="var(--ink-3)" opacity="0.6" />
      <path d="M10 99h100" stroke="var(--ink-3)" stroke-width="1" stroke-dasharray="2 4" opacity="0.4" />
      <rect x="18" y="26" width="30" height="12" rx="6" transform="rotate(-24 33 32)" fill="var(--ink-3)" opacity="0.45" />
      <rect x="66" y="48" width="32" height="12" rx="6" transform="rotate(-58 82 54)" fill="var(--accent)" opacity="0.6" />
      <rect x="40" y="78" width="34" height="12" rx="6" fill="var(--accent)" />
      <path d="M74 84c6 0 8 4 13 4s7-3 11-3" fill="none" stroke="var(--accent)" stroke-width="1.4" stroke-linecap="round" />
    </g>
  )}
</svg>
